+import { afterEach, describe, expect, it } from "vitest";
+import type { SessionEntry } from "../src/index.ts";
+import { ThinkingProvenanceCliFixture } from "./fixtures/jev-thinking-provenance/cli-fixture.ts";
+
+const task = "Please implement a careful multi-file change with tests and explain the concurrency implications";
+const independent =
+	"Please inspect this independent lengthy task and explain all relevant implementation details carefully";
+
+function userEntry(entries: SessionEntry[]): SessionEntry {
+	const entry = entries.find((entry) => entry.type === "message" && entry.message.role === "user");
+	if (!entry) throw new Error("Missing user entry");
+	return entry;
+}
+
+function lastDecision(entries: SessionEntry[]): unknown {
+	const entry = entries.findLast((entry) => entry.type === "custom" && entry.customType === "jev-pilot:effort");
+	return entry?.type === "custom" ? entry.data : undefined;
+}
+
+describe("experimental thinking provenance through the source CLI", () => {
+	let fixture: ThinkingProvenanceCliFixture;
+	afterEach(async () => {
+		await fixture?.close();
+	});
+
+	async function start(thinking?: string, reasoning = true) {
+		fixture = new ThinkingProvenanceCliFixture();
+		await fixture.start(thinking, reasoning);
+		return fixture;
+	}
+
+	it("CLI-1 / AC-1 restores medium after fork-before without a startup override", async () => {
+		await start();
+		await fixture.prompt(task);
+		const user = userEntry(await fixture.entries());
+		await fixture.command("fork", { entryId: user.id });
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "medium" });
+		fixture.noChange();
+		await fixture.prompt(independent);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("medium");
+		expect(lastDecision(await fixture.entries())).toMatchObject({ effective: "medium" });
+	});
+
+	it("CLI-2 / AC-2 honors explicit high when it equals excluded provisional high", async () => {
+		await start("high");
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "high" });
+		await fixture.command("set_thinking_level", { level: "medium" });
+		await fixture.prompt(task);
+		await fixture.command("fork", { entryId: userEntry(await fixture.entries()).id });
+		const restored = await fixture.command("get_state");
+		fixture.noChange();
+		await fixture.prompt(independent);
+		expect({
+			restored,
+			effort: fixture.generations.at(-1)?.reasoning_effort,
+			retained: lastDecision(await fixture.entries()),
+		}).toMatchObject({
+			restored: { thinkingLevel: "high" },
+			effort: "high",
+			retained: { effective: "high" },
+		});
+	});
+
+	it("CLI-3 / AC-3 tree navigation replays retained manual low instead of startup high", async () => {
+		await start("high");
+		await fixture.prompt(task);
+		await fixture.command("set_thinking_level", { level: "low" });
+		const manual = (await fixture.entries()).findLast(
+			(entry) => entry.type === "thinking_level_change" && entry.thinkingLevel === "low",
+		)!;
+		await fixture.prompt(task);
+		await fixture.command("prompt", { message: `/fixture-tree ${manual.id}` });
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "low" });
+		fixture.noChange();
+		await fixture.prompt(independent);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("low");
+	});
+
+	it("CLI-4 / AC-4 reload keeps manual low without reapplying the startup option", async () => {
+		await start("high");
+		await fixture.prompt(task);
+		await fixture.command("set_thinking_level", { level: "low" });
+		await fixture.command("prompt", { message: "/fixture-reload" });
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "low" });
+		fixture.noChange();
+		await fixture.prompt(independent);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("low");
+		expect((await fixture.starts()).at(-1)).toEqual({ type: "session_start", reason: "reload" });
+	});
+
+	it("CLI-5 / AC-5 fork-at retains its owner and reusable high decision", async () => {
+		await start();
+		await fixture.prompt(task);
+		await fixture.command("prompt", { message: `/fixture-fork-at ${userEntry(await fixture.entries()).id}` });
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "high" });
+		fixture.noChange();
+		await fixture.prompt("continue");
+		expect(fixture.classifications).toHaveLength(1);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("high");
+		expect(lastDecision(await fixture.entries())).toMatchObject({ outcome: "reused", effective: "high" });
+	});
+
+	it.each([
+		["steering", "set_steering_mode", "steer"],
+		["follow-up", "set_follow_up_mode", "follow_up"],
+	])("CLI-6 / AC-6 %s all reuses the immediately preceding low lookup", async (_name, setMode, enqueue) => {
+		await start();
+		await fixture.prompt(task);
+		await fixture.command(setMode, { mode: "all" });
+		fixture.modelDelay = 300;
+		const offset = fixture.records.length;
+		await fixture.command("prompt", { message: task });
+		await fixture.wait(() => fixture.generations.length === 2);
+		fixture.response.answers.effort = { choice: "low", confidence: 0.99 };
+		await fixture.command(enqueue, {
+			message: "What is the ordinary low effort lookup for this exact independent question?",
+		});
+		await fixture.command(enqueue, { message: "continue" });
+		await fixture.wait(() => fixture.records.slice(offset).some((record) => record.type === "agent_settled"));
+		expect(fixture.generations.map((request) => request.reasoning_effort)).toEqual(["high", "high", "low"]);
+		expect(fixture.classifications).toHaveLength(3);
+		const entries = await fixture.entries();
+		const users = entries.filter((entry) => entry.type === "message" && entry.message.role === "user").slice(-2);
+		const receipts = entries
+			.filter((entry) => entry.type === "custom" && entry.customType === "jev-pilot:effort")
+			.slice(-2);
+		expect(receipts.map((entry) => (entry.type === "custom" ? entry.data : undefined))).toMatchObject([
+			{
+				ownerEntryId: users[0].id,
+				outcome: "classified",
+				effective: "low",
+				decision: { effort: 0, effortConfidence: 0.99 },
+			},
+			{
+				ownerEntryId: users[1].id,
+				outcome: "reused",
+				effective: "low",
+				decision: { effort: 0, effortConfidence: 0.99 },
+			},
+		]);
+		expect(users[0].id).not.toBe(users[1].id);
+	});
+
+	it("CLI-7 / AC-7 active abort cancels classifier HTTP without applying fallback", async () => {
+		await start();
+		fixture.classifierDelay = 500;
+		const offset = fixture.records.length;
+		await fixture.command("prompt", { message: task });
+		await fixture.wait(() => fixture.classifications.length === 1);
+		await fixture.command("abort");
+		await fixture.wait(() => fixture.records.slice(offset).some((record) => record.type === "agent_settled"));
+		await fixture.wait(() => fixture.classifierAborts === 1);
+		expect(fixture.generations).toHaveLength(0);
+		expect(
+			(await fixture.entries()).filter(
+				(entry) =>
+					entry.type === "custom" &&
+					["jev-pilot:effort", "jev-pilot:effort-application"].includes(entry.customType),
+			),
+		).toHaveLength(0);
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "medium" });
+		fixture.classifierDelay = 0;
+		await fixture.prompt(task);
+		expect(fixture.generations).toHaveLength(1);
+		expect(fixture.generations[0].reasoning_effort).toBe("high");
+	});
+
+	it("CLI-8 / AC-8 session effort and replacement never mutate global defaults", async () => {
+		await start("high");
+		await fixture.command("set_thinking_level", { level: "medium" });
+		await fixture.prompt(task);
+		await fixture.command("fork", { entryId: userEntry(await fixture.entries()).id });
+		expect(await fixture.settings()).toBe(fixture.settingsBefore);
+	});
+
+	it("CLI-9 / AC-9 explicit off remains authoritative rather than meaning absent", async () => {
+		await start("off");
+		await fixture.command("set_thinking_level", { level: "medium" });
+		await fixture.prompt(task);
+		await fixture.command("fork", { entryId: userEntry(await fixture.entries()).id });
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "off" });
+		fixture.noChange();
+		await fixture.prompt(independent);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("none");
+		expect((await fixture.starts()).at(-1)).toMatchObject({ reason: "fork", thinkingLevelOverride: "off" });
+	});
+
+	it("CLI-10 / AC-10 raw max override is distinguished from effective high", async () => {
+		await start("max");
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "high" });
+		await fixture.command("set_thinking_level", { level: "medium" });
+		await fixture.prompt(task);
+		await fixture.command("fork", { entryId: userEntry(await fixture.entries()).id });
+		expect(await fixture.command("get_state")).toMatchObject({ thinkingLevel: "high" });
+		fixture.noChange();
+		await fixture.prompt(independent);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("high");
+		expect((await fixture.starts()).at(-1)).toMatchObject({ thinkingLevelOverride: "max" });
+	});
+
+	it("CLI-11 / AC-11 new resume and clone use replacement factory provenance", async () => {
+		await start("high");
+		fixture.noChange();
+		await fixture.prompt(independent);
+		const original = await fixture.command<{ sessionFile: string }>("get_state");
+		await fixture.command("set_thinking_level", { level: "low" });
+		await fixture.command("new_session");
+		expect((await fixture.starts()).at(-1)).toMatchObject({ reason: "new", thinkingLevelOverride: "high" });
+		await fixture.prompt(independent);
+		await fixture.command("switch_session", { sessionPath: original.sessionFile });
+		expect((await fixture.starts()).at(-1)).toMatchObject({ reason: "resume", thinkingLevelOverride: "high" });
+		await fixture.prompt(independent);
+		await fixture.command("clone");
+		expect((await fixture.starts()).at(-1)).toMatchObject({ reason: "fork", thinkingLevelOverride: "high" });
+		await fixture.prompt(independent);
+		expect(fixture.generations.map((request) => request.reasoning_effort)).toEqual(["high", "high", "high", "high"]);
+	});
+
+	it("CLI-13 / AC-13 orphan applications cannot acquire a later ineligible owner", async () => {
+		await start();
+		await fixture.prompt(task);
+		await fixture.command("fork", { entryId: userEntry(await fixture.entries()).id });
+		await fixture.prompt("/unregistered-command");
+		const fork = await fixture.command<{ sessionFile: string }>("get_state");
+		await fixture.command("new_session");
+		await fixture.command("switch_session", { sessionPath: fork.sessionFile });
+		fixture.noChange();
+		await fixture.prompt("continue");
+		expect(fixture.classifications).toHaveLength(2);
+		expect(fixture.generations.at(-1)?.reasoning_effort).toBe("medium");
+	});
+});
