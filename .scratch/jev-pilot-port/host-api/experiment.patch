@@ -0,0 +1,207 @@
+import { clampThinkingLevel, type ModelThinkingLevel } from "@earendil-works/pi-ai";
+import type { ExtensionAPI, ExtensionContext, SessionEntry } from "@earendil-works/pi-coding-agent";
+import { classifierState } from "./classifier-context.ts";
+import { type EffortDecision, isContinuation, selectEffort } from "./effort-policy.ts";
+import { classify, type SystemOneConfig, systemOneConfig } from "./system-one.ts";
+
+const STATE_TYPE = "jev-pilot:effort";
+const APPLICATION_TYPE = "jev-pilot:effort-application";
+const RESTORED_TYPE = "jev-pilot:effort-restored";
+
+/** Effort-only adapter: never replaces the selected model or writes global defaults. */
+export default function (pi: ExtensionAPI): void {
+	let active: AbortController | undefined;
+	let pending: PendingEffort[] = [];
+	const dispose = () => {
+		active?.abort();
+		active = undefined;
+		pending = [];
+	};
+	const commitPending = (ctx: ExtensionContext) => {
+		const branch = ctx.sessionManager.getBranch();
+		for (const state of pending) {
+			if (state.signal.aborted || state.sessionId !== ctx.sessionManager.getSessionId()) continue;
+			const applicationIndex = branch.findIndex((entry) => entry.id === state.data.applicationId);
+			if (applicationIndex === -1) continue;
+			const owner = branch
+				.slice(applicationIndex + 1)
+				.find((entry) => entry.type === "message" && entry.message.role === "user");
+			if (owner) pi.appendEntry(STATE_TYPE, { ...state.data, ownerEntryId: owner.id });
+		}
+		pending = [];
+	};
+	const restoreThinking = (ctx: ExtensionContext, hasCreationOverride: boolean) => {
+		const branch = ctx.sessionManager.getBranch();
+		const desired = ownedThinking(branch);
+		if (!desired) return;
+		// Experimental host provenance identifies an explicit creation input, including off
+		// and values equal to restored history. The host already applied model clamping.
+		const restored = hasCreationOverride ? pi.getThinkingLevel() : desired;
+		// Close any application whose user was excluded, including when an explicit
+		// startup override wins. A future unrelated user must never become its owner.
+		pi.appendEntry(RESTORED_TYPE, { thinkingLevel: restored });
+		pi.setThinkingLevel(restored);
+	};
+	pi.on("session_shutdown", dispose);
+	pi.on("session_start", (event, ctx) => {
+		dispose();
+		restoreThinking(ctx, event.reason !== "reload" && event.thinkingLevelOverride !== undefined);
+	});
+	pi.on("session_tree", (_event, ctx) => {
+		dispose();
+		restoreThinking(ctx, false);
+	});
+	pi.on("agent_end", () => {
+		pending = [];
+	});
+	pi.on("context", (_event, ctx) => {
+		commitPending(ctx);
+	});
+
+	// before_agent_start has no active agent signal in Pi 1.3.0. User message_start
+	// is awaited before request preparation, includes queued input, and owns cancellation.
+	pi.on("message_start", async (event, ctx) => {
+		if (event.message.role !== "user") return;
+		// Pi persisted the preceding queued user at message_end. Commit it before a
+		// following continuation reads its predecessor, even in steering mode "all".
+		commitPending(ctx);
+		const prompt =
+			typeof event.message.content === "string"
+				? event.message.content
+				: event.message.content
+						.filter((part) => part.type === "text")
+						.map((part) => part.text)
+						.join("\n");
+		if (!prompt.trim() || /^\/\S/.test(prompt.trim())) return;
+		let config: SystemOneConfig;
+		try {
+			config = systemOneConfig();
+			if (!ctx.model || !ctx.modelRegistry.hasConfiguredAuth(ctx.model))
+				throw new Error("Select a configured physical Pi model with authentication before submitting work.");
+		} catch (error) {
+			ctx.ui.notify(error instanceof Error ? error.message : "Invalid Jev Pilot configuration.", "error");
+			ctx.abort();
+			return;
+		}
+		const controller = new AbortController();
+		active = controller;
+		const parentSignal = ctx.signal;
+		const cancel = () => controller.abort();
+		parentSignal?.addEventListener("abort", cancel, { once: true });
+		if (parentSignal?.aborted) cancel();
+		try {
+			const previous = previousDecision(ctx);
+			const reused = previous !== null && isContinuation(prompt);
+			const result = reused
+				? { outcome: "classified" as const, decision: previous }
+				: await classify(
+						config,
+						await classifierState(
+							ctx,
+							prompt,
+							pi.getAllTools().map((tool) => tool.name),
+						),
+						controller.signal,
+					);
+			if (controller.signal.aborted) return;
+			const current = pi.getThinkingLevel();
+			const decision = result.outcome === "classified" ? result.decision : null;
+			const requested = decision ? (selectEffort(decision, current, prompt) ?? current) : current;
+			const effective = clampThinkingLevel(ctx.model!, requested);
+			// setThinkingLevel appends before the owning user is persisted. Record its
+			// baseline first so a branch excluding that user can discard this change.
+			const state: DecisionState = {
+				requested,
+				effective,
+				outcome: reused ? "reused" : result.outcome,
+				decision: decision ?? previous,
+			};
+			pi.appendEntry(APPLICATION_TYPE, { baseline: current, ...state });
+			const applicationId = ctx.sessionManager.getLeafId()!;
+			pi.setThinkingLevel(requested);
+			pending.push({
+				sessionId: ctx.sessionManager.getSessionId(),
+				signal: parentSignal ?? controller.signal,
+				data: { applicationId, ...state },
+			});
+			ctx.ui.setStatus("jev-pilot", `jev · ${requested} → ${effective} · ${reused ? "reused" : result.outcome}`);
+		} catch {
+			if (!controller.signal.aborted)
+				ctx.ui.notify("Jev Pilot could not classify this input; current effort is unchanged.", "warning");
+		} finally {
+			parentSignal?.removeEventListener("abort", cancel);
+			if (active === controller) active = undefined;
+		}
+	});
+}
+
+interface EffortState extends DecisionState {
+	applicationId: string;
+	ownerEntryId?: string;
+}
+interface DecisionState {
+	requested: ModelThinkingLevel;
+	effective: ModelThinkingLevel;
+	outcome: string;
+	decision: EffortDecision | null;
+}
+interface PendingEffort {
+	sessionId: string;
+	signal: AbortSignal;
+	data: EffortState;
+}
+interface EffortApplication extends DecisionState {
+	baseline: ModelThinkingLevel;
+}
+
+function ownedApplications(branch: SessionEntry[]): Set<string> {
+	const owned = new Set<string>();
+	let applicationId: string | undefined;
+	for (const entry of branch) {
+		if (entry.type === "custom" && entry.customType === RESTORED_TYPE) applicationId = undefined;
+		if (entry.type === "custom" && entry.customType === APPLICATION_TYPE) applicationId = entry.id;
+		if (entry.type === "message" && entry.message.role === "user" && applicationId) {
+			owned.add(applicationId);
+			applicationId = undefined;
+		}
+	}
+	return owned;
+}
+
+/** Replay manual changes and only applications whose owning user is on this branch. */
+function ownedThinking(branch: SessionEntry[]): ModelThinkingLevel | undefined {
+	const committed = ownedApplications(branch);
+	let level: ModelThinkingLevel | undefined;
+	let application: { id: string; data: EffortApplication } | undefined;
+	for (const entry of branch) {
+		if (entry.type === "custom" && entry.customType === APPLICATION_TYPE) {
+			application = { id: entry.id, data: entry.data as EffortApplication };
+			level ??= application.data.baseline;
+			continue;
+		}
+		if (entry.type === "custom" && entry.customType === RESTORED_TYPE) {
+			level = (entry.data as { thinkingLevel: ModelThinkingLevel }).thinkingLevel;
+		}
+		if (entry.type === "thinking_level_change") {
+			const provisional =
+				application &&
+				application.data.baseline !== application.data.effective &&
+				entry.thinkingLevel === application.data.effective;
+			if (!provisional || committed.has(application!.id)) level = entry.thinkingLevel as ModelThinkingLevel;
+		}
+		application = undefined;
+	}
+	return level;
+}
+
+function previousDecision(ctx: ExtensionContext): EffortDecision | null {
+	const branch = ctx.sessionManager.getBranch();
+	const owned = ownedApplications(branch);
+	for (const entry of branch.reverse()) {
+		if (entry.type !== "custom") continue;
+		if (entry.customType !== STATE_TYPE && !(entry.customType === APPLICATION_TYPE && owned.has(entry.id))) continue;
+		const data = entry.data as DecisionState | undefined;
+		return data?.decision ?? null;
+	}
+	return null;
+}
diff --git a/packages/coding-agent/test/fixtures/jev-thinking-provenance/system-one.ts b/packages/coding-agent/test/fixtures/jev-thinking-provenance/system-one.ts
new file mode 100644
index 0000000..cafb5ad
--- /dev/null
+++ b/packages/coding-agent/test/fixtures/jev-thinking-provenance/system-one.ts
@@ -0,0 +1,161 @@
+// Effort and risk questions adapted from pinned Jev Pilot; see NOTICE.md.
+import { EFFORT_ORDER, type EffortDecision } from "./effort-policy.ts";
+
+export interface SystemOneConfig {
+	url: string;
+	apiKey: string;
+	model: string;
+	timeoutMs: number;
+}
+
+export function systemOneConfig(): SystemOneConfig {
+	const url = process.env.JEV_SYSTEM_ONE_URL ?? "https://api.typesafe.ai/v1/systemone";
+	let parsed: URL;
+	try {
+		parsed = new URL(url);
+	} catch {
+		throw new Error("Set JEV_SYSTEM_ONE_URL to a valid HTTP(S) System One endpoint.");
+	}
+	if (!["https:", "http:"].includes(parsed.protocol) || parsed.username || parsed.password)
+		throw new Error("Set JEV_SYSTEM_ONE_URL to an HTTP(S) System One endpoint without embedded credentials.");
+	const apiKey = process.env.JEV_SYSTEM_ONE_API_KEY ?? process.env.TYPESAFE_API_KEY ?? "";
+	if (!apiKey.trim()) throw new Error("Set JEV_SYSTEM_ONE_API_KEY (or TYPESAFE_API_KEY) for System One.");
+	const model = process.env.JEV_SYSTEM_ONE_MODEL ?? "jev-latest";
+	if (!model.trim()) throw new Error("Set JEV_SYSTEM_ONE_MODEL to a decision model ID (default: jev-latest).");
+	const timeoutMs = Number(process.env.JEV_TIMEOUT_MS ?? 1500);
+	if (!Number.isSafeInteger(timeoutMs) || timeoutMs <= 0)
+		throw new Error("Set JEV_TIMEOUT_MS to a positive integer in milliseconds (default: 1500).");
+	return { url, apiKey, model, timeoutMs };
+}
+
+const rubric = [
+	"Answered from what is already known, or mechanical work with nothing to work out: a lookup, a single command, a rename or find-and-replace (even across many files), a search that lists what it finds, formatting, a one-line change.",
+	"An ordinary, well-specified change to one or a few files, or a direct question about code already in view.",
+	"A change across several files that needs working out, a bug whose cause is described but has to be traced, writing tests, or reviewing a diff with care.",
+	"Design across several components, a bug whose cause is unknown, a refactor with many dependents, or careful reasoning about concurrency, performance or failure modes.",
+	"Novel architecture, a security or data-integrity question, a failure that resisted earlier attempts, or work where a subtle mistake is costly and hard to undo.",
+];
+
+const questions = {
+	effort: {
+		type: "choice",
+		instructions:
+			'How much step-by-step reasoning does the work this request asks for need? Rate the work, not how important the topic sounds: a question or advice answered in words, even about architecture or security, is low or medium, and reviewing a small diff is medium. A short reply that approves, continues or picks an option ("go ahead", "fix all and continue", "1") takes the size of the work it approves, from the recent conversation.',
+		criteria: Object.fromEntries(EFFORT_ORDER.map((level, index) => [level, rubric[index]])),
+	},
+	risky: {
+		type: "noul",
+		instructions:
+			"Carrying out this task would itself change production, move real money, or alter data that cannot be restored. Writing or testing code that deals with such things, without running it against the real system, does not count.",
+		criteria: {
+			true: "Doing the task runs something against a real system with lasting effect: deploying or releasing, changing production data or configuration, moving money, deleting or overwriting data with no backup, or rewriting shared history (force-push).",
+			false: "Reading, explaining, planning, or writing and testing code locally, even code that deals with production, payments or data, without running it against the real system.",
+		},
+	},
+};
+
+function object(value: unknown): Record<string, unknown> | null {
+	return value !== null && typeof value === "object" && !Array.isArray(value)
+		? (value as Record<string, unknown>)
+		: null;
+}
+function probability(value: unknown): value is number {
+	return typeof value === "number" && Number.isFinite(value) && value >= 0 && value <= 1;
+}
+
+/** Reject malformed values before they can change the current effort. */
+function readDecision(value: unknown): EffortDecision | null {
+	const answers = object(object(value)?.answers);
+	const effort = object(answers?.effort);
+	const risk = object(answers?.risky);
+	if (!answers || !effort || !risk) return null;
+	const risky = risk.noul ?? risk.probability;
+	if (!probability(risky)) return null;
+	if (effort.confidence !== undefined && !probability(effort.confidence)) return null;
+	const raw = effort.probabilities;
+	let probabilities: Record<string, number> | null = null;
+	if (raw !== undefined) {
+		const distribution = object(raw);
+		if (
+			!distribution ||
+			!Object.keys(distribution).length ||
+			Object.values(distribution).some((value) => !probability(value))
+		)
+			return null;
+		const named = EFFORT_ORDER.some((level) => level in distribution);
+		const keys = named ? [...EFFORT_ORDER] : ["0", "1", "2", "3", "4"];
+		if (Object.keys(distribution).some((key) => !keys.includes(key))) return null;
+		probabilities = Object.fromEntries(keys.map((key, index) => [String(index), distribution[key] ?? 0])) as Record<
+			string,
+			number
+		>;
+		const total = Object.values(probabilities).reduce((sum, value) => sum + value, 0);
+		if (Math.abs(total - 1) > 0.02) return null;
+	}
+	const choice = EFFORT_ORDER.indexOf(effort.choice as (typeof EFFORT_ORDER)[number]);
+	const score = effort.score;
+	if (
+		!probabilities &&
+		choice === -1 &&
+		!(typeof score === "number" && Number.isFinite(score) && score >= 0 && score <= 4)
+	)
+		return null;
+	const confidence = effort.confidence as number | undefined;
+	return {
+		effort: probabilities
+			? Object.entries(probabilities).reduce((sum, [level, value]) => sum + Number(level) * value, 0)
+			: choice !== -1
+				? choice
+				: (score as number),
+		effortConfidence: confidence ?? (probabilities ? Math.max(...Object.values(probabilities)) : null),
+		effortProbabilities: probabilities,
+		risky,
+	};
+}
+
+export type Classification =
+	| { outcome: "classified"; decision: EffortDecision }
+	| { outcome: "timeout" | "service-error" | "schema-error" };
+
+/** Deadline cancels transport; parent cancellation rejects and is never fail-open. */
+export async function classify(config: SystemOneConfig, state: unknown, signal: AbortSignal): Promise<Classification> {
+	const controller = new AbortController();
+	let timedOut = false;
+	const cancel = () => controller.abort(signal.reason);
+	signal.addEventListener("abort", cancel, { once: true });
+	if (signal.aborted) cancel();
+	const timer = setTimeout(() => {
+		timedOut = true;
+		controller.abort();
+	}, config.timeoutMs);
+	try {
+		const response = await fetch(config.url, {
+			method: "POST",
+			headers: {
+				"content-type": "application/json",
+				authorization: `Bearer ${config.apiKey}`,
+			},
+			body: JSON.stringify({ model: config.model, state, questions }),
+			signal: controller.signal,
+		});
+		if (!response.ok) {
+			await response.body?.cancel();
+			return { outcome: "service-error" };
+		}
+		let value: unknown;
+		try {
+			value = await response.json();
+		} catch (error) {
+			if (controller.signal.aborted) throw error;
+			return { outcome: "schema-error" };
+		}
+		const decision = readDecision(value);
+		return decision ? { outcome: "classified", decision } : { outcome: "schema-error" };
+	} catch (error) {
+		if (signal.aborted) throw error;
+		return { outcome: timedOut ? "timeout" : "service-error" };
+	} finally {
+		clearTimeout(timer);
+		signal.removeEventListener("abort", cancel);
+	}
+}
