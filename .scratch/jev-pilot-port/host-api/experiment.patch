index 0000000..0fb12ca
--- /dev/null
+++ b/packages/coding-agent/test/fixtures/jev-thinking-provenance/cli-fixture.ts
@@ -0,0 +1,228 @@
+import { type ChildProcessWithoutNullStreams, spawn } from "node:child_process";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { createServer, type Server } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { setTimeout as sleep } from "node:timers/promises";
+import { fileURLToPath } from "node:url";
+import type { SessionEntry, SessionStartEvent } from "../../../src/index.ts";
+
+interface RpcRecord {
+	id?: string;
+	type: string;
+	success?: boolean;
+	data?: unknown;
+}
+
+export class ThinkingProvenanceCliFixture {
+	directory = "";
+	process!: ChildProcessWithoutNullStreams;
+	server!: Server;
+	records: RpcRecord[] = [];
+	generations: Record<string, unknown>[] = [];
+	classifications: unknown[] = [];
+	classifierAborts = 0;
+	classifierDelay = 0;
+	modelDelay = 0;
+	response = { answers: { effort: { choice: "high", confidence: 0.95 }, risky: { noul: 0 } } };
+	stderr = "";
+	settingsBefore = "";
+	private sequence = 0;
+
+	async start(thinking?: string, reasoning = true): Promise<void> {
+		this.directory = await mkdtemp(join(tmpdir(), "pi-thinking-provenance-"));
+		const agentDir = join(this.directory, "agent");
+		await mkdir(agentDir);
+		this.server = createServer(async (request, response) => {
+			let text = "";
+			for await (const chunk of request) text += chunk.toString();
+			const body = JSON.parse(text) as Record<string, unknown>;
+			if (request.url === "/systemone") {
+				this.classifications.push(body);
+				response.on("close", () => {
+					if (!response.writableEnded) this.classifierAborts++;
+				});
+				await sleep(this.classifierDelay);
+				response.setHeader("content-type", "application/json");
+				response.end(JSON.stringify(this.response));
+				return;
+			}
+			this.generations.push(body);
+			await sleep(this.modelDelay);
+			const chunk = {
+				id: "fixture",
+				object: "chat.completion.chunk",
+				created: 1,
+				model: "fixture-model",
+				choices: [
+					{
+						index: 0,
+						delta: { role: "assistant", content: "Fixture answer. Shall I implement?" },
+						finish_reason: null,
+					},
+				],
+			};
+			const end = {
+				...chunk,
+				choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+				usage: { prompt_tokens: 10, completion_tokens: 4, total_tokens: 14 },
+			};
+			response.setHeader("content-type", "text/event-stream");
+			response.end(`data: ${JSON.stringify(chunk)}\n\ndata: ${JSON.stringify(end)}\n\ndata: [DONE]\n\n`);
+		});
+		await new Promise<void>((resolve) => this.server.listen(0, "127.0.0.1", resolve));
+		const address = this.server.address();
+		if (!address || typeof address === "string") throw new Error("No fixture server address");
+		const url = `http://127.0.0.1:${address.port}`;
+		await writeFile(
+			join(agentDir, "models.json"),
+			JSON.stringify({
+				providers: {
+					fixture: {
+						baseUrl: `${url}/v1`,
+						api: "openai-completions",
+						apiKey: "fixture-not-a-credential",
+						models: [
+							{
+								id: "fixture-model",
+								reasoning,
+								input: ["text"],
+								contextWindow: 32000,
+								maxTokens: 512,
+								thinkingLevelMap: {
+									off: "none",
+									minimal: null,
+									low: "low",
+									medium: "medium",
+									high: "high",
+									xhigh: null,
+									max: null,
+								},
+							},
+						],
+					},
+				},
+			}),
+		);
+		this.settingsBefore = JSON.stringify({
+			defaultThinkingLevel: "medium",
+			retry: { enabled: false },
+			compaction: { enabled: false },
+		});
+		await writeFile(join(agentDir, "settings.json"), this.settingsBefore);
+		const resolver = fileURLToPath(new URL("../../../src/experimental/source-resolver.ts", import.meta.url));
+		const cli = fileURLToPath(new URL("../../../src/cli.ts", import.meta.url));
+		this.process = spawn(
+			process.execPath,
+			[
+				"--import",
+				resolver,
+				cli,
+				"--mode",
+				"rpc",
+				"--no-extensions",
+				"-e",
+				fileURLToPath(new URL("extension.ts", import.meta.url)),
+				"-e",
+				fileURLToPath(new URL("controls.ts", import.meta.url)),
+				"--no-mcp",
+				"--no-skills",
+				"--no-prompt-templates",
+				"--no-themes",
+				"--no-context-files",
+				"--no-tools",
+				"--offline",
+				"--no-approve",
+				"--model",
+				"fixture/fixture-model",
+				...(thinking === undefined ? [] : ["--thinking", thinking]),
+			],
+			{
+				cwd: this.directory,
+				env: {
+					PATH: process.env.PATH,
+					HOME: this.directory,
+					PI_CODING_AGENT_DIR: agentDir,
+					PI_OFFLINE: "1",
+					PI_TELEMETRY: "0",
+					HOST_API_EVENTS: join(this.directory, "events.jsonl"),
+					JEV_SYSTEM_ONE_URL: `${url}/systemone`,
+					JEV_SYSTEM_ONE_API_KEY: "fixture-not-a-credential",
+					JEV_TIMEOUT_MS: "10000",
+				},
+			},
+		);
+		let pending = "";
+		this.process.stdout.on("data", (data: Buffer) => {
+			pending += data.toString();
+			while (pending.includes("\n")) {
+				const index = pending.indexOf("\n");
+				const line = pending.slice(0, index);
+				pending = pending.slice(index + 1);
+				try {
+					this.records.push(JSON.parse(line) as RpcRecord);
+				} catch {
+					this.stderr += line;
+				}
+			}
+		});
+		this.process.stderr.on("data", (data: Buffer) => {
+			this.stderr += data.toString();
+		});
+		await this.command("get_state");
+	}
+
+	async wait(predicate: () => boolean): Promise<void> {
+		const until = Date.now() + 12000;
+		while (!predicate()) {
+			if (Date.now() > until || this.process.exitCode !== null)
+				throw new Error(`CLI deadline/exit: ${this.stderr}; ${JSON.stringify(this.records.slice(-5))}`);
+			await sleep(10);
+		}
+	}
+
+	async command<T = unknown>(type: string, data: Record<string, unknown> = {}): Promise<T> {
+		const id = `request-${++this.sequence}`;
+		this.process.stdin.write(`${JSON.stringify({ id, type, ...data })}\n`);
+		await this.wait(() => this.records.some((record) => record.id === id));
+		const response = this.records.find((record) => record.id === id)!;
+		if (!response.success) throw new Error(JSON.stringify(response));
+		return response.data as T;
+	}
+
+	async prompt(message: string): Promise<void> {
+		const offset = this.records.length;
+		await this.command("prompt", { message });
+		await this.wait(() => this.records.slice(offset).some((record) => record.type === "agent_settled"));
+	}
+
+	async entries(): Promise<SessionEntry[]> {
+		return (await this.command<{ entries: SessionEntry[] }>("get_entries")).entries;
+	}
+
+	async starts(): Promise<SessionStartEvent[]> {
+		return (await readFile(join(this.directory, "events.jsonl"), "utf8"))
+			.trim()
+			.split("\n")
+			.map((line) => JSON.parse(line) as SessionStartEvent);
+	}
+
+	async settings(): Promise<string> {
+		return readFile(join(this.directory, "agent/settings.json"), "utf8");
+	}
+
+	noChange(): void {
+		this.response = { answers: { effort: { choice: "low", confidence: 0 }, risky: { noul: 0 } } };
+	}
+
+	async close(): Promise<void> {
+		if (this.process && this.process.exitCode === null) {
+			this.process.stdin.end();
+			await Promise.race([new Promise<void>((resolve) => this.process.once("exit", () => resolve())), sleep(3000)]);
+			if (this.process.exitCode === null) this.process.kill("SIGKILL");
+		}
+		this.server?.closeAllConnections();
+		if (this.server) await new Promise<void>((resolve) => this.server.close(() => resolve()));
+		if (this.directory) await rm(this.directory, { recursive: true, force: true });
+	}
+}
