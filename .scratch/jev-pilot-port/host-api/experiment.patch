+import { appendFileSync } from "node:fs";
+import type { ExtensionAPI } from "../../../src/index.ts";
+
+export default function (pi: ExtensionAPI) {
+	pi.on("session_start", (event) => {
+		appendFileSync(process.env.HOST_API_EVENTS!, `${JSON.stringify(event)}\n`);
+	});
+	pi.registerCommand("fixture-tree", {
+		handler: async (id, ctx) => {
+			await ctx.navigateTree(id, { summarize: false });
+		},
+	});
+	pi.registerCommand("fixture-fork-at", {
+		handler: async (id, ctx) => {
+			await ctx.fork(id, { position: "at" });
+		},
+	});
+	pi.registerCommand("fixture-reload", {
+		handler: async (_args, ctx) => {
+			await ctx.reload();
+		},
+	});
+}
diff --git a/packages/coding-agent/test/fixtures/jev-thinking-provenance/effort-policy.ts b/packages/coding-agent/test/fixtures/jev-thinking-provenance/effort-policy.ts
